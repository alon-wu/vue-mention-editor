{
  "name": "vue-mention-editor",
  "version": "0.1.0",
  "description": "基于 Tiptap 的 Vue 3 提及（@mention）富文本编辑器组件，支持多触发符与自定义下拉面板",
  "keywords": [
    "vue",
    "vue3",
    "tiptap",
    "mention",
    "editor",
    "rich-text",
    "suggestion"
  ],
  "homepage": "https://github.com/alon-wu/vue-mention-editor#readme",
  "bugs": {
    "url": "https://github.com/alon-wu/vue-mention-editor/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alon-wu/vue-mention-editor.git"
  },
  "license": "MIT",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "bun@1.4.1",
  "scripts": {
    "dev": "vite",
    "build": "bun run typecheck && vite build",
    "build:demo": "vite build --config vite.demo.config.ts",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "build:site": "bun run build:demo && bun run docs:build && bun scripts/build-site.ts",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "vite preview",
    "prepublishOnly": "bun run build"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.8.0",
    "@tiptap/core": "^3.31.3",
    "@tiptap/extension-document": "^3.31.3",
    "@tiptap/extension-hard-break": "^3.31.3",
    "@tiptap/extension-mention": "^3.31.3",
    "@tiptap/extension-paragraph": "^3.31.3",
    "@tiptap/extension-text": "^3.31.3",
    "@tiptap/extensions": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/suggestion": "^3.31.3",
    "@tiptap/vue-3": "^3.31.3"
  },
  "devDependencies": {
    "@tiptap/starter-kit": "^3.31.3",
    "@types/node": "^26.6.2",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/test-utils": "^2.5.1",
    "jsdom": "^30.1.0",
    "prettier": "^3.9.8",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vite-plugin-dts": "^5.1.0",
    "vitepress": "^1.6.4",
    "vitest": "^5.0.1",
    "vue": "^3.5.43",
    "vue-tsc": "^3.3.11"
  }
}
